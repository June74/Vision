CREATE TABLE "calendar_sync_maintenance" (
	"owner_id" text NOT NULL,
	"provider" text NOT NULL,
	"provider_calendar_id" text NOT NULL,
	"connection_version" integer NOT NULL,
	"checkpoint_version" integer NOT NULL,
	"renewal_generation" integer DEFAULT 0 NOT NULL,
	"renewal_lease_id" text,
	"renewal_lease_expires_at" timestamp with time zone,
	"renewal_failures" integer DEFAULT 0 NOT NULL,
	"current_channel_row_id" text,
	"created_at" timestamp with time zone NOT NULL,
	"updated_at" timestamp with time zone NOT NULL,
	CONSTRAINT "calendar_sync_maintenance_owner_id_provider_provider_calendar_id_pk" PRIMARY KEY("owner_id","provider","provider_calendar_id"),
	CONSTRAINT "calendar_sync_maintenance_owner_non_empty" CHECK ("calendar_sync_maintenance"."owner_id" <> ''),
	CONSTRAINT "calendar_sync_maintenance_provider_non_empty" CHECK ("calendar_sync_maintenance"."provider" <> ''),
	CONSTRAINT "calendar_sync_maintenance_calendar_non_empty" CHECK ("calendar_sync_maintenance"."provider_calendar_id" <> ''),
	CONSTRAINT "calendar_sync_maintenance_connection_version_positive" CHECK ("calendar_sync_maintenance"."connection_version" > 0),
	CONSTRAINT "calendar_sync_maintenance_checkpoint_version_non_negative" CHECK ("calendar_sync_maintenance"."checkpoint_version" >= 0),
	CONSTRAINT "calendar_sync_maintenance_generation_non_negative" CHECK ("calendar_sync_maintenance"."renewal_generation" >= 0),
	CONSTRAINT "calendar_sync_maintenance_failures_non_negative" CHECK ("calendar_sync_maintenance"."renewal_failures" >= 0),
	CONSTRAINT "calendar_sync_maintenance_lease_consistent" CHECK (("calendar_sync_maintenance"."renewal_lease_id" is null) = ("calendar_sync_maintenance"."renewal_lease_expires_at" is null)),
	CONSTRAINT "calendar_sync_maintenance_timestamps_valid" CHECK ("calendar_sync_maintenance"."updated_at" >= "calendar_sync_maintenance"."created_at")
);
--> statement-breakpoint
ALTER TABLE "sync_channels" ADD COLUMN "renewal_generation" integer;--> statement-breakpoint
ALTER TABLE "sync_channels" ADD COLUMN "renewal_lease_id" text;--> statement-breakpoint
ALTER TABLE "sync_channels" ADD COLUMN "cleanup_required" boolean DEFAULT false NOT NULL;--> statement-breakpoint
CREATE UNIQUE INDEX "sync_channels_one_pending_renewal_uq" ON "sync_channels" USING btree ("owner_id","provider","provider_calendar_id") WHERE "sync_channels"."lifecycle" = 'pending';--> statement-breakpoint
CREATE INDEX "sync_channels_cleanup_idx" ON "sync_channels" USING btree ("owner_id","provider","provider_calendar_id","cleanup_required","lifecycle");--> statement-breakpoint
ALTER TABLE "sync_channels" ADD CONSTRAINT "sync_channels_renewal_generation_positive" CHECK ("sync_channels"."renewal_generation" is null or "sync_channels"."renewal_generation" > 0);--> statement-breakpoint
ALTER TABLE "sync_channels" ADD CONSTRAINT "sync_channels_renewal_lease_consistent" CHECK (("sync_channels"."lifecycle" in ('pending', 'failed')) = ("sync_channels"."renewal_lease_id" is not null) or "sync_channels"."lifecycle" in ('active', 'retired'));
