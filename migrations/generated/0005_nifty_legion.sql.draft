ALTER TABLE "calendar_sync_maintenance" ADD COLUMN "credential_failure_checkpoint_version" integer;--> statement-breakpoint
ALTER TABLE "calendar_sync_maintenance" ADD COLUMN "credential_failure_category" text;--> statement-breakpoint
ALTER TABLE "calendar_sync_maintenance" ADD CONSTRAINT "calendar_sync_maintenance_credential_version_non_negative" CHECK ("calendar_sync_maintenance"."credential_failure_checkpoint_version" is null or "calendar_sync_maintenance"."credential_failure_checkpoint_version" >= 0);--> statement-breakpoint
ALTER TABLE "calendar_sync_maintenance" ADD CONSTRAINT "calendar_sync_maintenance_credential_category_valid" CHECK ("calendar_sync_maintenance"."credential_failure_category" is null or "calendar_sync_maintenance"."credential_failure_category" in ('authorization', 'concurrency', 'database', 'provider', 'payload_too_large', 'quota', 'schema', 'sync_token_invalid', 'transient'));--> statement-breakpoint
ALTER TABLE "calendar_sync_maintenance" ADD CONSTRAINT "calendar_sync_maintenance_credential_marker_consistent" CHECK (("calendar_sync_maintenance"."credential_failure_checkpoint_version" is null) = ("calendar_sync_maintenance"."credential_failure_category" is null));
